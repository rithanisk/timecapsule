# Timecapsule uses Replit PostgreSQL and App Storage in this workspace.
# DATABASE_URL and object-storage settings are managed by Replit, not copied here.

# Optional public URL for integrations that need an absolute app URL.
NEXT_PUBLIC_APP_URL=

# Optional Supabase adapter placeholders; the current Replit-native app does not read them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Web Push. The public key must match in both values for Vite and the API.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
