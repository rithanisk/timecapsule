{
  "name": "Timecapsule",
  "tagline": "Different places. One photobooth.",
  "colors": {
    "paper": "#FBF7F0",
    "ink": "#292723",
    "coral": "#E5786A",
    "sage": "#A9C7BD",
    "sky": "#AFC4E6",
    "warmYellow": "#EBCB8B",
    "border": "#D9D1C5",
    "white": "#FFFDF8"
  },
  "typography": {
    "functional": "Inter, ui-sans-serif, system-ui, sans-serif",
    "editorial": "Georgia, Times New Roman, serif"
  },
  "radii": {
    "small": "12px",
    "medium": "18px",
    "large": "28px",
    "pill": "999px"
  },
  "motion": {
    "revealDelayMs": 180,
    "revealDurationMs": 1100,
    "revealEasing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "settleOvershootPx": 8,
    "actionsFadeMs": 220,
    "reducedMotionFadeMs": 180
  },
  "accessibility": {
    "minimumTouchTargetPx": 44,
    "contrastTarget": "WCAG AA"
  }
}
